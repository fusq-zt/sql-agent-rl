{
  "agent": {
    "feedback_mode": "structured",
    "max_turns": 3,
    "n_runners": 8,
    "agent_match": "^(write_query|rewrite_query)$"
  },
  "model_revision": "2e1fd397ee46e1388853d2af2c993145b0f1098a",
  "verl": {
    "algorithm": {
      "adv_estimator": "grpo",
      "use_kl_in_reward": false
    },
    "data": {
      "train_files": "data/splits/train.parquet",
      "val_files": "data/splits/internal_dev.parquet",
      "train_batch_size": 32,
      "max_prompt_length": 4096,
      "max_response_length": 2048,
      "truncation": "error",
      "seed": 2026
    },
    "actor_rollout_ref": {
      "rollout": {
        "tensor_model_parallel_size": 1,
        "n": 4,
        "log_prob_micro_batch_size_per_gpu": 1,
        "multi_turn": {
          "format": "hermes"
        },
        "name": "vllm",
        "gpu_memory_utilization": 0.6,
        "engine_kwargs": {
          "vllm": {
            "enable_auto_tool_choice": true,
            "tool_call_parser": "hermes",
            "seed": 2026
          }
        },
        "temperature": 0.7,
        "top_p": 1.0,
        "top_k": -1,
        "max_num_seqs": 8,
        "max_num_batched_tokens": 4096,
        "enable_prefix_caching": false
      },
      "actor": {
        "ppo_mini_batch_size": 32,
        "ppo_micro_batch_size_per_gpu": 1,
        "optim": {
          "lr": 1e-06
        },
        "use_kl_loss": false,
        "kl_loss_coef": 0.0,
        "entropy_coeff": 0,
        "clip_ratio_low": 0.2,
        "clip_ratio_high": 0.3,
        "fsdp_config": {
          "param_offload": true,
          "optimizer_offload": true
        },
        "clip_ratio_c": 3.0,
        "ppo_epochs": 1,
        "loss_agg_mode": "token-mean",
        "strategy": "fsdp"
      },
      "ref": {
        "log_prob_micro_batch_size_per_gpu": 1,
        "fsdp_config": {
          "param_offload": true
        }
      },
      "model": {
        "path": "models/qwen2.5-coder-1.5b",
        "use_remove_padding": true,
        "enable_gradient_checkpointing": true,
        "lora_rank": 0
      }
    },
    "trainer": {
      "n_gpus_per_node": 2,
      "val_before_train": true,
      "critic_warmup": 0,
      "logger": [
        "console"
      ],
      "project_name": "SQLAgentRL",
      "experiment_name": "grpo",
      "nnodes": 1,
      "test_freq": 52,
      "total_epochs": 2,
      "save_freq": 52,
      "default_local_dir": "runs/grpo/checkpoints",
      "max_actor_ckpt_to_keep": 1,
      "resume_mode": "disable"
    },
    "agentlightning": {
      "trace_aggregator": {
        "level": "transition"
      }
    }
  }
}
